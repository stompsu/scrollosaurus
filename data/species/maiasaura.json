  "summary": {
    "en": "Maiasaura was a duck-billed plant-eater from Montana, USA, that lived during the Campanian, about 80–75 million years ago. Its name means 'good mother lizard' because it was found with nests and young, showing that some dinosaurs cared for their babies. It grew to around nine metres long."
  },
  "funFacts": [
    {
      "text": {
        "en": "Maiasaura was named from a nest of juveniles, which gave evidence of family life among dinosaurs."
      },
      "sourceIds": ["horner-makela-1979"]
    }
